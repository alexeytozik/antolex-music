# Application
APP_ENV=development
JWT_SECRET=replace-with-at-least-32-random-bytes
# Set only during the one-time upgrade if existing localStorage tokens used another secret.
LEGACY_JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://music.antolex.net
AUTH_CODE_TTL=10m
SESSION_TTL=720h
UPLOAD_SESSION_TTL=168h
SESSION_COOKIE_NAME=antolex_session
SESSION_COOKIE_SECURE=false

# PostgreSQL and Redis (local defaults are intentionally simple)
POSTGRES_DB=music_stream
POSTGRES_USER=music
POSTGRES_PASSWORD=replace-with-a-random-database-password
# Internal Docker connection. URL-encode special characters in the password.
COMPOSE_DATABASE_URL=postgres://music:replace-with-a-random-database-password@postgres:5432/music_stream?sslmode=disable
# Host connection used by local scripts.
DATABASE_URL=postgres://music:replace-with-a-random-database-password@localhost:5432/music_stream?sslmode=disable
REDIS_URL=redis://localhost:6379/0
ANTOLEX_BACKUP_DIR=./backups/postgres

# Email
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_USERNAME=your-mailjet-api-key
SMTP_PASSWORD=your-mailjet-secret-key
SMTP_FROM="ANTOLEX Music <auth@antolex.net>"

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=antolex-music
R2_SOURCE_BUCKET_NAME=tozikron-music
# Target/application credentials. Grant access only to the new bucket.
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Separate read-only credentials for the old bucket are recommended for migration.
# Leave both empty only when the target credential can also read the source bucket.
R2_SOURCE_ACCESS_KEY_ID=
R2_SOURCE_SECRET_ACCESS_KEY=
# Optional; scripts derive the standard endpoint from R2_ACCOUNT_ID when empty.
R2_ENDPOINT=

# Caddy
ANTOLEX_DOMAIN=music.antolex.net
